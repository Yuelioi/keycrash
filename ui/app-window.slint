/*
THESIS: 普通模式安全检测单组合，Windows 与 Mac 专业模式手动编排并测试按键序列。
OWN-WORLD: 冷灰仪器面板、墨黑读数、青色确认、红橙操作，以及检测时出现的正交信号轨迹。
STORY: 用户点选 modifier tags，点击开始，只按一个目标键，然后读取结论与证据边界。
FIRST VIEWPORT: 460×380 单窗口，上方是品牌和状态，中部是 modifier tags、目标键读数与测量轨迹，底部只有一个主操作。
FORM: 信号轨迹视觉世界；证据剖面式层级，种子 132c565a。
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
*/

import { CheckBox, ScrollView, ComboBox, SpinBox } from "std-widgets.slint";

export struct FilterChoice { name: string, path: string, pid: int, selected: bool }
export struct RecordedEvent { time: string, key: string, action: string, injected: bool }
export struct SequenceStep { action: int, key: string, delay: int, done: bool }
export struct ObservedResponse { time: string, app: string, path: string, kind: string, value: string, pid: int, tid: int, architecture: string, binding: string, matched: bool, input-range: string }

component LanguageSelect inherits Rectangle {
    in property <string> language;
    in property <bool> enabled: true;
    in property <string> accessible-name;
    callback selected(string);
    property <[string]> labels: ["简体中文", "English", "日本語"];
    property <[string]> codes: ["zh", "en", "ja"];
    property <int> current: language == "en" ? 1 : language == "ja" ? 2 : 0;
    property <int> highlighted;
    property <bool> keyboard-focus: false;
    property <bool> expanded: false;

    width: 112px;
    height: 30px;
    border-radius: 8px;
    background: touch.has-hover && enabled ? #edf1f2 : #f8fafb;
    border-width: 1px;
    border-color: focus.has-focus && keyboard-focus && enabled ? #536168 : #aab6bc;
    opacity: enabled ? 1 : 0.42;
    forward-focus: focus;
    accessible-role: combobox;
    accessible-label: accessible-name;
    accessible-value: labels[current];
    accessible-enabled: enabled;
    accessible-expandable: true;
    accessible-expanded: expanded;
    accessible-action-expand => { root.open(); }
    accessible-action-default => { root.open(); }

    function open() {
        if root.enabled {
            root.highlighted = root.current;
            root.expanded = true;
            menu.show();
        }
    }

    Text {
        x: 10px; width: parent.width - 34px; height: parent.height;
        text: root.labels[root.current]; color: #344249; font-size: 12px;
        vertical-alignment: center;
        accessible-role: none;
    }
    Path {
        x: parent.width - 18px; y: 13px; width: 8px; height: 4px;
        commands: "M 0 0 L 4 4 L 8 0";
        stroke: #536168; stroke-width: 1.4px;
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        focus-lost => { root.keyboard-focus = false; }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.keyboard-focus = false; root.open(); }
    }
    menu := PopupWindow {
        x: 0px; y: root.height + 5px;
        width: root.width; height: 104px;
        close-policy: close-on-click-outside;
        forward-focus: menu-focus;
        Rectangle {
            background: #f8fafb;
            border-radius: 8px;
            border-width: 1px; border-color: #b8c2c7;
        }
        menu-focus := FocusScope {
            focus-changed-event => { root.expanded = self.has-focus; }
            for label[index] in root.labels : Rectangle {
                x: 4px; y: 4px + index * 32px; width: parent.width - 8px; height: 32px;
                border-radius: 5px;
                background: row-touch.has-hover || root.highlighted == index ? #e3e9ec : transparent;
                accessible-role: button;
                accessible-label: label;
                accessible-action-default => { root.selected(root.codes[index]); menu.close(); }
                Text {
                    x: 8px; height: parent.height; text: label;
                    font-size: 12px; font-weight: root.current == index ? 650 : 400;
                    color: #344249; vertical-alignment: center;
                }
                row-touch := TouchArea {
                    clicked => { root.keyboard-focus = false; root.selected(root.codes[index]); menu.close(); }
                }
            }
        }
    }
}

component SignalTrace inherits Rectangle {
    in property <color> signal-color;
    in property <bool> active;

    background: transparent;
    opacity: active ? 1 : 0;
    animate opacity { duration: 160ms; easing: ease-out; }

    Rectangle { x: 0px; y: 9px; width: 39px; height: 2px; background: root.signal-color; }
    Rectangle { x: 38px; y: 3px; width: 2px; height: 8px; background: root.signal-color; }
    Rectangle { x: 39px; y: 3px; width: 29px; height: 2px; background: root.signal-color; }
    Rectangle { x: 67px; y: 3px; width: 2px; height: 8px; background: root.signal-color; }
    Rectangle { x: 68px; y: 9px; width: 128px; height: 2px; background: root.signal-color; }

    Rectangle { x: 0px; y: 23px; width: 69px; height: 2px; background: root.signal-color; }
    Rectangle { x: 68px; y: 16px; width: 2px; height: 9px; background: root.signal-color; }
    Rectangle { x: 69px; y: 16px; width: 31px; height: 2px; background: root.signal-color; }
    Rectangle { x: 99px; y: 16px; width: 2px; height: 9px; background: root.signal-color; }
    Rectangle { x: 100px; y: 23px; width: 96px; height: 2px; background: root.signal-color; }

    Rectangle { x: 0px; y: 37px; width: 105px; height: 2px; background: root.signal-color; }
    Rectangle { x: 104px; y: 30px; width: 2px; height: 9px; background: root.signal-color; }
    Rectangle { x: 105px; y: 30px; width: 31px; height: 2px; background: root.signal-color; }
    Rectangle { x: 135px; y: 30px; width: 2px; height: 9px; background: root.signal-color; }
    Rectangle { x: 136px; y: 37px; width: 60px; height: 2px; background: root.signal-color; }

    Rectangle { x: 195px; y: 9px; width: 2px; height: 30px; background: root.signal-color; }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> action-color;
    callback clicked;

    height: 44px;
    border-radius: 10px;
    background: root.action-color;
    opacity: !root.enabled ? 0.42 : touch.pressed ? 0.78 : touch.has-hover ? 0.9 : 1;
    forward-focus: focus-scope;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-action-default => { touch.clicked(); }

    animate opacity { duration: 110ms; easing: ease-out; }

    Text {
        text: root.text;
        color: #ffffff;
        font-size: 13px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    focus-scope := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    if (focus-scope.has-focus && root.enabled) : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 13px;
        border-width: 2px;
        border-color: #11171c;
    }
}

component ModifierTag inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <string> add-label: "添加 ";
    in property <string> remove-label: "移除 ";
    callback toggled;

    width: 58px;
    height: 30px;
    border-radius: 9px;
    background: root.selected ? #11171c : #f8fafb;
    border-width: 1px;
    border-color: root.selected ? #11171c : #aab6bc;
    opacity: root.enabled ? (touch.pressed ? 0.76 : touch.has-hover ? 0.9 : 1) : 0.58;
    forward-focus: focus-scope;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-label: root.selected ? root.remove-label + root.text : root.add-label + root.text;
    accessible-action-default => { touch.clicked(); }

    animate background, opacity { duration: 110ms; easing: ease-out; }

    Text {
        text: root.selected ? root.text + "  ×" : "+  " + root.text;
        color: root.selected ? #ffffff : #344249;
        font-size: 12px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    focus-scope := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            focus-scope.focus();
            root.toggled();
        }
    }

    if (focus-scope.has-focus && root.enabled) : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 11px;
        border-width: 2px;
        border-color: #c9342a;
    }
}

component OutlineButton inherits Rectangle {
    in property <string> text;
    in property <string> accessible-name: root.text;
    in property <bool> enabled: true;
    in property <length> corner-radius: 8px;
    in property <length> label-size: 13px;
    callback clicked;

    background: touch.pressed ? #d7dddf : touch.has-hover ? #f8fafb : transparent;
    border-width: 1px;
    border-color: #aab6bc;
    border-radius: root.corner-radius;
    opacity: root.enabled ? 1 : 0.42;
    forward-focus: focus-scope;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.accessible-name;
    accessible-action-default => { touch.clicked(); }

    animate background, opacity { duration: 110ms; easing: ease-out; }

    property <bool> focus-ring-visible: false;

    Text {
        text: root.text;
        overflow: elide;
        color: #344249;
        font-size: root.label-size;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    focus-scope := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => {
            root.focus-ring-visible = reason == FocusReason.tab-navigation
                || reason == FocusReason.programmatic;
        }
        focus-lost => {
            root.focus-ring-visible = false;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && focus-scope.has-focus) {
                focus-scope.clear-focus();
            }
        }
        clicked => {
            root.clicked();
        }
    }

    if (focus-scope.has-focus && root.focus-ring-visible && root.enabled) : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: root.corner-radius + 2px;
        border-width: 2px;
        border-color: #11171c;
    }
}

component MoveStepButton inherits OutlineButton {
    in property <bool> up;
    text: "";
    width: 28px;
    height: 28px;
    corner-radius: 4px;
    border-width: 0px;
    Path {
        x: 9px; y: 11px; width: 10px; height: 6px;
        commands: root.up ? "M 0 6 L 5 1 L 10 6" : "M 0 0 L 5 5 L 10 0";
        fill: transparent;
        stroke: #536168; stroke-width: 1.5px;
    }
}

component DeleteStepButton inherits OutlineButton {
    text: "";
    width: 28px;
    height: 28px;
    corner-radius: 4px;
    border-width: 0px;
    Path {
        x: 9px; y: 9px; width: 10px; height: 10px;
        commands: "M 1 1 L 9 9 M 9 1 L 1 9";
        fill: transparent;
        stroke: #536168; stroke-width: 1.5px;
    }
}

export component AppWindow inherits Window {
    width: 460px;
    height: root.help-visible ? 620px : root.professional ? 700px : root.filter-visible ? 560px : root.is-macos && root.filter-available ? 468px : 420px;
    in property <string> app-version;
    in property <bool> is-macos: false;
    title: "KeyCrash v" + root.app-version;
    icon: @image-url("../assets/keycrash-icon.svg");
    background: #dce2e5;

    in-out property <string> mode: "idle";
    in-out property <string> state-title: "选择修饰键";
    in-out property <string> state-detail: "单击 Ctrl、Alt、Shift、Win；开始后只按一个目标键。";
    in-out property <string> shortcut-text: "等待目标键";
    in-out property <string> evidence-text: "安全输入 · 不发送完整组合";
    in-out property <string> action-text: "开始检测";
    in-out property <color> accent: #c9342a;
    in-out property <bool> ctrl-selected: false;
    in-out property <bool> alt-selected: false;
    in-out property <bool> shift-selected: false;
    in-out property <bool> win-selected: false;
    in-out property <bool> action-enabled: true;
    in-out property <string> owner-path: "";
    in-out property <string> language: "zh";
    in-out property <bool> help-visible: false;
    in-out property <bool> help-professional: false;
    property <length> help-scroll-y: 0px;
    public function open-instructions() {
        if (!root.professional-busy && root.mode != "locating") {
            if (root.mode == "waiting-key") { root.cancel-requested(); }
            root.help-professional = root.professional;
            root.help-scroll-y = 0px;
            root.sequence-key-capturing = false;
            root.help-visible = true;
            help-focus.focus();
        }
    }
    in-out property <bool> professional: false;
    in-out property <bool> include-admin: false;
    in-out property <bool> recording-admin: false;
    property <bool> professional-busy: root.mode == "sequence-testing";
    in-out property <[SequenceStep]> sequence-steps;
    in-out property <[string]> sequence-keys;
    in-out property <int> sequence-key: 0;
    in-out property <bool> sequence-key-capturing: false;
    in-out property <bool> sequence-key-capture-unknown: false;
    property <bool> sequence-editable: !root.professional-busy && !root.sequence-key-capturing;
    callback sequence-capture-requested();
    callback sequence-key-captured(int);
    in-out property <int> sequence-action-kind: 0;
    in-out property <int> sequence-delay: 100;
    in-out property <int> sequence-tab: 0;
    in-out property <bool> sequence-valid: false;
    in-out property <bool> sequence-scope-ready: false;
    in-out property <string> sequence-validation;
    callback sequence-add();
    callback sequence-edit(int, int);
    in-out property <[string]> sequence-history;
    in-out property <string> sequence-history-error;
    property <length> history-offset: root.sequence-history.length > 0 ? 36px : 0px;
    callback sequence-clear();
    callback sequence-history-action(int, bool);
    callback sequence-action();
    in-out property <[RecordedEvent]> recorded-events;
    in-out property <string> recorded-summary;
    in-out property <string> recording-status;
    in-out property <[ObservedResponse]> recorded-responses;
    callback detection-mode-changed(bool);
    in-out property <bool> filter-visible: false;
    in-out property <bool> filter-available: false;
    in-out property <bool> filter-running: false;
    in-out property <[FilterChoice]> filter-choices;
    in-out property <int> filter-selected: 0;
    in-out property <string> filter-message;
    in-out property <string> filter-report;
    callback show-filters();
    callback toggle-filter(int, bool);
    callback start-filters();

    callback begin-detection(bool, bool, bool, bool);
    callback action-key-entered(string, bool, bool, bool, bool);
    callback cancel-requested();
    callback modifiers-changed();
    callback locate-owner();
    callback open-owner-location();
    callback open-github();
    callback language-changed(string);

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: transparent;

        capture-focus := FocusScope {
            x: -1px;
            y: -1px;
            width: 1px;
            height: 1px;
            enabled: root.mode == "waiting-key" && !root.help-visible;
            key-pressed(event) => {
                if (event.modifiers.control || event.modifiers.alt || event.modifiers.shift || event.modifiers.meta) {
                    return accept;
                }
                root.action-key-entered(event.text, root.ctrl-selected, root.alt-selected, root.shift-selected, root.win-selected);
                return accept;
            }
        }

        Rectangle {
            x: 28px;
            y: 24px;
            width: parent.width - 56px;
            height: 99px;
            background: transparent;

            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 34px;
                alignment: start;
                spacing: 10px;

                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 8px;
                    background: #11171c;

                    Text {
                        text: "K";
                        color: #f3f6f7;
                        font-size: 17px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        x: 6px;
                        y: 27px;
                        width: 22px;
                        height: 2px;
                        background: root.accent;
                    }
                }

                VerticalLayout {
                    spacing: 1px;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 7px;
                        Text {
                            text: "KeyCrash";
                            color: #11171c;
                            font-size: 16px;
                            font-weight: 700;
                        }
                        Text {
                            text: "v" + root.app-version;
                            color: #536168;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: root.language == "en" ? "One key to find the conflict" : root.language == "ja" ? "1 キーで競合を検出" : "一按，找到快捷键冲突";
                        color: #536168;
                        font-size: 11px;
                    }
                }
            }

            Text {
                x: 0px;
                y: 90px;
                width: parent.width;
                height: 30px;
                text: root.state-title;
                color: #11171c;
                font-size: 25px;
                font-weight: 700;
                overflow: elide;
                visible: !root.help-visible;
            }

            Text {
                x: 0px;
                y: 123px;
                width: parent.width;
                height: 16px;
                text: root.state-detail;
                color: #45545b;
                font-size: 13px;
                overflow: elide;
                visible: !root.help-visible;
            }
        }

        Rectangle {
            x: 28px;
            y: 178px;
            width: parent.width - 56px;
            height: 142px;
            background: #edf1f2;
            border-width: 1px;
            border-color: #b8c2c7;
            border-radius: 14px;
            drop-shadow-color: #26343c26;
            drop-shadow-offset-y: 7px;
            drop-shadow-blur: 18px;
            visible: !root.professional && !root.help-visible && root.mode != "filter-result";

            Rectangle { x: 18px; y: 29px; width: parent.width - 36px; height: 1px; background: root.mode == "waiting-key" ? #cdd5d8 : #e4e9ea; }
            Rectangle { x: 18px; y: 57px; width: parent.width - 36px; height: 1px; background: root.mode == "waiting-key" ? #cdd5d8 : #e4e9ea; }
            Rectangle { x: 18px; y: 85px; width: parent.width - 36px; height: 1px; background: root.mode == "waiting-key" ? #cdd5d8 : #e4e9ea; }
            Rectangle { x: 18px; y: 113px; width: parent.width - 36px; height: 1px; background: root.mode == "waiting-key" ? #cdd5d8 : #e4e9ea; }
            Rectangle { x: 79px; y: 16px; width: 1px; height: parent.height - 32px; background: root.mode == "waiting-key" ? #d7dddf : #e8eced; }
            Rectangle { x: 151px; y: 16px; width: 1px; height: parent.height - 32px; background: root.mode == "waiting-key" ? #d7dddf : #e8eced; }
            Rectangle { x: 223px; y: 16px; width: 1px; height: parent.height - 32px; background: root.mode == "waiting-key" ? #d7dddf : #e8eced; }
            Rectangle { x: 295px; y: 16px; width: 1px; height: parent.height - 32px; background: root.mode == "waiting-key" ? #d7dddf : #e8eced; }
            Rectangle { x: 367px; y: 16px; width: 1px; height: parent.height - 32px; background: root.mode == "waiting-key" ? #d7dddf : #e8eced; }

            HorizontalLayout {
                x: 18px;
                y: 17px;
                width: parent.width - 36px;
                height: 30px;
                spacing: 7px;
                alignment: start;

                ModifierTag {
                    text: root.is-macos ? "⌃ Ctrl" : "Ctrl";
                    width: root.is-macos ? 78px : 58px;
                    add-label: root.language == "en" ? "Add " : root.language == "ja" ? "追加 " : "添加 ";
                    remove-label: root.language == "en" ? "Remove " : root.language == "ja" ? "削除 " : "移除 ";
                    selected: root.ctrl-selected;
                    enabled: root.mode != "waiting-key" && root.mode != "locating";
                    toggled => {
                        root.ctrl-selected = !root.ctrl-selected;
                        root.modifiers-changed();
                    }
                }
                ModifierTag {
                    text: root.is-macos ? "⌥ Opt" : "Alt";
                    width: root.is-macos ? 78px : 58px;
                    add-label: root.language == "en" ? "Add " : root.language == "ja" ? "追加 " : "添加 ";
                    remove-label: root.language == "en" ? "Remove " : root.language == "ja" ? "削除 " : "移除 ";
                    selected: root.alt-selected;
                    enabled: root.mode != "waiting-key" && root.mode != "locating";
                    toggled => {
                        root.alt-selected = !root.alt-selected;
                        root.modifiers-changed();
                    }
                }
                ModifierTag {
                    text: root.is-macos ? "⇧ Shift" : "Shift";
                    width: root.is-macos ? 78px : 58px;
                    add-label: root.language == "en" ? "Add " : root.language == "ja" ? "追加 " : "添加 ";
                    remove-label: root.language == "en" ? "Remove " : root.language == "ja" ? "削除 " : "移除 ";
                    selected: root.shift-selected;
                    enabled: root.mode != "waiting-key" && root.mode != "locating";
                    toggled => {
                        root.shift-selected = !root.shift-selected;
                        root.modifiers-changed();
                    }
                }
                ModifierTag {
                    text: root.is-macos ? "⌘ Cmd" : "Win";
                    width: root.is-macos ? 78px : 58px;
                    add-label: root.language == "en" ? "Add " : root.language == "ja" ? "追加 " : "添加 ";
                    remove-label: root.language == "en" ? "Remove " : root.language == "ja" ? "削除 " : "移除 ";
                    selected: root.win-selected;
                    enabled: root.mode != "waiting-key" && root.mode != "locating";
                    toggled => {
                        root.win-selected = !root.win-selected;
                        root.modifiers-changed();
                    }
                }
            }

            Text {
                x: 18px;
                y: 58px;
                width: 190px;
                height: 38px;
                visible: root.mode != "waiting-key" && root.mode != "locating";
                text: root.language == "en"
                    ? (root.ctrl-selected || root.alt-selected || root.shift-selected || root.win-selected ? "Click a selected tag to remove it" : "Add the modifiers you need")
                    : root.language == "ja"
                        ? (root.ctrl-selected || root.alt-selected || root.shift-selected || root.win-selected ? "選択済みのタグをクリックして削除" : "必要な修飾キーを追加")
                        : (root.ctrl-selected || root.alt-selected || root.shift-selected || root.win-selected ? "已选 tag 可再次单击移除" : "单击添加需要的修饰键");
                color: #5e6c72;
                font-size: 11px;
                wrap: word-wrap;
            }

            SignalTrace {
                x: 24px;
                y: 55px;
                width: 196px;
                height: 46px;
                signal-color: root.accent;
                active: root.mode == "waiting-key" || root.mode == "locating";
            }

            Rectangle {
                x: 218px;
                y: 58px;
                width: parent.width - 242px;
                height: 44px;
                background: #f8fafb;
                border-width: 1px;
                border-color: root.accent;
                border-radius: 10px;

                Text {
                    x: 6px;
                    y: 4px;
                    width: parent.width - 12px;
                    height: parent.height - 8px;
                    text: root.shortcut-text;
                    color: #11171c;
                    font-size: 13px;
                    font-weight: 650;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                x: 18px;
                y: 118px;
                width: parent.width - 36px;
                height: 16px;
                alignment: space-between;

                Text {
                    text: root.mode == "available" ? (root.is-macos ? "CHECKED" : "NO CONFLICT") : root.mode == "owner-found" ? "OWNER" : root.mode == "occupied" ? "BLOCKED" : root.mode == "reserved" ? (root.is-macos ? "SYSTEM SETTING" : "RESERVED") : root.mode == "locating" ? "LOCATING" : root.mode == "waiting-key" ? "LOCAL INPUT" : root.mode == "error" ? "ERROR" : "STANDBY";
                    color: root.accent;
                    font-size: 10px;
                    font-weight: 700;
                }
                Text {
                    text: root.evidence-text;
                    color: #5e6c72;
                    font-size: 10px;
                    horizontal-alignment: right;
                    overflow: elide;
                }
            }
        }

        HorizontalLayout {
            x: 28px;
            y: 354px;
            width: parent.width - 56px;
            height: 44px;
            alignment: space-between;
            spacing: 14px;
            visible: !root.professional && !root.help-visible;

            if (root.mode == "owner-found") : OutlineButton {
                width: 132px;
                height: 44px;
                corner-radius: 10px;
                label-size: 12px;
                text: root.language == "en" ? "Open file location" : root.language == "ja" ? "ファイルの場所を開く" : "打开文件位置";
                enabled: root.owner-path != "";
                clicked => { root.open-owner-location(); }
            }

            if (root.mode != "owner-found") : HorizontalLayout {
                spacing: 7px;
                VerticalLayout {
                    width: 8px;
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 2px;
                        background: root.accent;
                    }
                }
                Text {
                    text: root.mode == "waiting-key"
                        ? (root.language == "en" ? "Click Cancel to stop" : root.language == "ja" ? "中止するにはキャンセルをクリック" : "点击取消可停止检测")
                        : root.filter-running ? (root.language == "en" ? "Restores listeners after checking" : root.language == "ja" ? "検査後にリスナーを復元" : "检查结束后恢复监听")
                        : root.mode == "locating"
                            ? (root.language == "en" ? "One trigger · Observe process messages" : root.language == "ja" ? "1 回送信 · プロセスメッセージを観測" : "触发一次 · 观察进程消息")
                            : (root.is-macos ? "macOS" : "Windows 10 / 11");
                    color: #59676d;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }

            ActionButton {
                width: 154px;
                text: root.action-text;
                enabled: root.action-enabled;
                action-color: root.accent;
                clicked => {
                    if (root.mode == "waiting-key" || (root.mode == "locating" && root.is-macos)) {
                        root.cancel-requested();
                    } else if (root.mode == "occupied" || (root.is-macos && (root.mode == "available" || root.mode == "reserved"))) {
                        root.locate-owner();
                    } else {
                        root.begin-detection(root.ctrl-selected, root.alt-selected, root.shift-selected, root.win-selected);
                        capture-focus.focus();
                    }
                }
            }
        }

        if (!root.professional && root.is-macos && root.filter-available && root.mode != "locating" && !root.help-visible) : OutlineButton {
            x: 28px; y: 410px; width: parent.width - 56px; height: 36px;
            text: root.language == "en" ? "Check global listeners" : root.language == "ja" ? "グローバル監視を調べる" : "检查全局监听";
            clicked => { root.show-filters(); filter-focus.focus(); }
        }

        if (root.mode == "filter-result" && !root.help-visible) : Rectangle {
            x: 28px; y: 178px; width: parent.width - 56px; height: 160px;
            background: #edf1f2; border-radius: 14px; border-width: 1px; border-color: #b8c2c7;
            Text { x: 12px; y: 10px; width: parent.width - 24px; height: 20px;
                text: root.shortcut-text; font-size: 13px; font-weight: 650; color: #11171c; }
            ScrollView {
                x: 12px; y: 36px; width: parent.width - 24px; height: parent.height - 46px;
                viewport-width: self.width;
                VerticalLayout {
                    alignment: start;
                    Text { min-width: 0px; text: root.filter-report; wrap: word-wrap; font-size: 12px; color: #11171c; }
                }
            }
        }

        help-focus := FocusScope {
            width: parent.width; height: parent.height;
            enabled: root.help-visible;
            if (root.help-visible) : Rectangle {
                x: 28px; y: 72px; width: parent.width - 56px; height: 500px;
                background: #edf1f2; border-radius: 14px; border-width: 1px; border-color: #b8c2c7;
                drop-shadow-color: #26343c26; drop-shadow-offset-y: 7px; drop-shadow-blur: 18px;
                Text {
                    x: 20px; y: 18px; width: parent.width - 40px; height: 28px;
                    text: root.language == "en" ? "How to use" : root.language == "ja" ? "使い方" : "使用说明";
                    color: #11171c; font-size: 22px; font-weight: 700;
                }
                HorizontalLayout {
                    x: 20px; y: 58px; width: parent.width - 40px; height: 30px; spacing: 8px;
                    OutlineButton {
                        text: root.language == "en" ? "Normal check" : root.language == "ja" ? "通常の検査" : "普通检测";
                        background: root.help-professional ? transparent : #f8fafb;
                        border-color: root.help-professional ? #aab6bc : #007a7e;
                        accessible-checkable: true; accessible-checked: !root.help-professional;
                        clicked => { root.help-scroll-y = 0px; root.help-professional = false; }
                    }
                    OutlineButton {
                        text: root.language == "en" ? "Sequence test" : root.language == "ja" ? "シーケンステスト" : "序列测试";
                        background: root.help-professional ? #f8fafb : transparent;
                        border-color: root.help-professional ? #007a7e : #aab6bc;
                        accessible-checkable: true; accessible-checked: root.help-professional;
                        clicked => { root.help-scroll-y = 0px; root.help-professional = true; }
                    }
                }
                help-scroll := ScrollView {
                    x: 20px; y: 106px; width: parent.width - 40px; height: parent.height - 158px;
                    viewport-width: self.visible-width - 16px;
                    viewport-height: max(self.visible-height, help-content.preferred-height);
                    viewport-y <=> root.help-scroll-y;
                    vertical-scrollbar-policy: always-on;
                    horizontal-scrollbar-policy: always-off;
                    help-content := VerticalLayout {
                        width: help-scroll.viewport-width;
                        height: self.preferred-height;
                        spacing: 14px; alignment: start;
                        if (!root.help-professional) : VerticalLayout {
                            height: self.preferred-height;
                            spacing: 12px; alignment: start;
                            Text { text: root.language == "en" ? "1  Choose modifiers" : root.language == "ja" ? "1  修飾キーを選ぶ" : "1  选择修饰键"; color: #11171c; font-size: 13px; font-weight: 650; }
                            if (!root.is-macos) : Text { text: root.language == "en" ? "Select Ctrl, Alt, Shift, or Win. Leave them off if not needed." : root.language == "ja" ? "Ctrl、Alt、Shift、Win を選びます。不要なら選択せずに進みます。" : "点选 Ctrl、Alt、Shift、Win；没有修饰键就直接开始。"; wrap: word-wrap; color: #45545b; font-size: 12px; }
                            if (root.is-macos) : Text { text: root.language == "en" ? "Select Control, Option, Shift, or Command. Leave them off if not needed." : root.language == "ja" ? "Control、Option、Shift、Command を選びます。不要なら選択せずに進みます。" : "点选 Control、Option、Shift、Command；没有修饰键就直接开始。"; wrap: word-wrap; color: #45545b; font-size: 12px; }
                            Text { text: root.language == "en" ? "2  Press the target key" : root.language == "ja" ? "2  対象キーを押す" : "2  输入目标键"; color: #11171c; font-size: 13px; font-weight: 650; }
                            Text { text: root.language == "en" ? "Click Start check, then press only the target key." : root.language == "ja" ? "「検出を開始」をクリックし、対象キーだけを押します。" : "点“开始检测”，只按要检查的那个键。"; wrap: word-wrap; color: #45545b; font-size: 12px; }
                            Text { text: root.language == "en" ? "3  Locate the app" : root.language == "ja" ? "3  使用中のアプリを調べる" : "3  定位占用软件"; color: #11171c; font-size: 13px; font-weight: 650; }
                            if (!root.is-macos) : Text { text: root.language == "en" ? "If a conflict is shown, click Locate the app. This may run the shortcut action." : root.language == "ja" ? "競合があれば「使用中のアプリを特定」をクリック。元の操作が実行される場合があります。" : "提示占用后，点“定位占用软件”。定位可能执行原快捷键操作。"; wrap: word-wrap; color: #45545b; font-size: 12px; }
                            if (root.is-macos) : Text { text: root.language == "en" ? "Click Locate the app and grant Accessibility access when prompted. This may run the shortcut action." : root.language == "ja" ? "「使用中のアプリを特定」をクリックし、案内に従ってアクセシビリティを許可します。元の操作が実行される場合があります。" : "点“定位占用软件”，按提示允许辅助功能。定位可能执行原快捷键操作。"; wrap: word-wrap; color: #45545b; font-size: 12px; }
                        }
                        if (root.help-professional) : VerticalLayout {
                            height: self.preferred-height;
                            spacing: 12px; alignment: start;
                            Text { text: root.language == "en" ? "1  Add key steps" : root.language == "ja" ? "1  キーステップを追加" : "1  添加按键步骤"; color: #11171c; font-size: 13px; font-weight: 650; }
                            Text { text: root.language == "en" ? "Choose an action, click Pick key and press one key, then click Add. For Wait, set a duration." : root.language == "ja" ? "動作を選び、「キーを入力」でキーを押して「追加」。待機は時間を指定します。" : "选择动作，点“按键选取”按一个键，再点“添加”。等待步骤填写时长。"; wrap: word-wrap; color: #45545b; font-size: 12px; }
                            Text { text: root.language == "en" ? "Ctrl+C+C: Ctrl down → tap C → wait 100 ms → tap C → Ctrl up." : root.language == "ja" ? "Ctrl+C+C：Ctrl 押下 → C を押して離す → 100 ms 待機 → C を押して離す → Ctrl 解放。" : "Ctrl+C+C：按下 Ctrl → 点按 C → 等待 100 ms → 点按 C → 松开 Ctrl。"; wrap: word-wrap; color: #45545b; font-size: 12px; }
                            Text { text: root.language == "en" ? "2  Test the sequence" : root.language == "ja" ? "2  シーケンスをテスト" : "2  测试序列"; color: #11171c; font-size: 13px; font-weight: 650; }
                            Text { text: root.language == "en" ? "Click Test sequence. For in-app shortcuts, switch to the target window within 3 seconds. Actions will run; Cancel test stops later keys." : root.language == "ja" ? "「シーケンスをテスト」をクリック。アプリ内操作は3秒以内に対象へ切り替えます。元の操作も実行され、「テストを取消」で後続のキーを止めます。" : "点“测试序列”；应用内快捷键请在 3 秒内切到目标窗口。测试会执行原操作，点“取消测试”停止后续按键。"; wrap: word-wrap; color: #45545b; font-size: 12px; }
                            if (!root.is-macos) : Text { text: root.language == "en" ? "To check administrator apps, enable Listen as administrator before testing." : root.language == "ja" ? "管理者アプリを調べるときは「管理者権限で監視」を選んでからテストします。" : "检查管理员软件时，勾选“以管理员权限监听”后再测试。"; wrap: word-wrap; color: #45545b; font-size: 12px; }
                            if (root.is-macos) : Text { text: root.language == "en" ? "Grant KeyCrash Accessibility access when prompted before testing." : root.language == "ja" ? "初回テストでは、案内に従って KeyCrash のアクセシビリティを許可します。" : "首次测试请按提示允许 KeyCrash 使用辅助功能。"; wrap: word-wrap; color: #45545b; font-size: 12px; }
                            Text { text: root.language == "en" ? "3  Read the results" : root.language == "ja" ? "3  結果を見る" : "3  查看结果"; color: #11171c; font-size: 13px; font-weight: 650; }
                            Text { text: root.language == "en" ? "Check Sent and Responses for the keys and responding apps. No response does not mean the shortcut is unused." : root.language == "ja" ? "送信と応答でキーと反応したアプリを確認します。応答がなくても未使用とは限りません。" : "在“发送记录”和“软件响应”中核对按键与响应的软件；无响应不代表未被使用。"; wrap: word-wrap; color: #45545b; font-size: 12px; }
                        }

                    }
                }
                Text { x: 20px; y: parent.height - 35px; width: parent.width - 156px; height: 18px;
                    text: root.language == "en" ? "Click × to return" : root.language == "ja" ? "× をクリックして戻る" : "点击右上角 × 返回";
                    color: #59676d; font-size: 11px; }
                OutlineButton { x: parent.width - 128px; y: parent.height - 41px; width: 108px; height: 30px;
                    text: "GitHub ↗";
                    accessible-name: root.language == "en" ? "Open GitHub repository" : root.language == "ja" ? "GitHub リポジトリを開く" : "打开 GitHub 仓库";
                    clicked => { root.open-github(); }
                }
            }
        }

        OutlineButton {
            x: 402px;
            y: 26px;
            width: 30px;
            height: 30px;
            text: root.help-visible ? "×" : "?";
            accessible-name: root.language == "en" ? (root.help-visible ? "Close instructions" : "Open instructions") : root.language == "ja" ? (root.help-visible ? "使い方を閉じる" : "使い方を開く") : (root.help-visible ? "关闭使用说明" : "打开使用说明");
            enabled: root.mode != "locating" && !root.professional-busy;
            clicked => {
                if (root.help-visible) {
                    root.help-visible = false;
                } else {
                    root.open-instructions();
                }
            }
        }

        LanguageSelect {
            x: 282px;
            y: 26px;
            width: 112px;
            height: 30px;
            language: root.language;
            enabled: root.mode != "locating" && !root.professional-busy;
            accessible-name: root.language == "en" ? "Language" : root.language == "ja" ? "言語" : "语言";
            selected(value) => {
                root.help-scroll-y = 0px;
                root.language-changed(value);
            }
        }

        if (!root.help-visible && !root.filter-visible) : HorizontalLayout {
            x: 28px; y: 73px; width: 230px; height: 30px; spacing: 6px;
            OutlineButton {
                text: root.language == "en" ? "Normal" : root.language == "ja" ? "通常モード" : "普通模式";
                border-color: root.professional ? #aab6bc : #11171c;
                background: root.professional ? transparent : #f8fafb;
                accessible-checkable: true; accessible-checked: !root.professional;
                enabled: !root.professional-busy && root.mode != "locating";
                clicked => { root.detection-mode-changed(false); }
            }
            OutlineButton {
                text: root.language == "en" ? "Professional" : root.language == "ja" ? "プロモード" : "专业模式";
                border-color: root.professional ? #007a7e : #aab6bc;
                background: root.professional ? #f8fafb : transparent;
                accessible-checkable: true; accessible-checked: root.professional;
                enabled: !root.professional-busy && root.mode != "locating";
                clicked => { root.detection-mode-changed(true); }
            }
        }

        if (root.professional && !root.help-visible) : Rectangle {
            x: 28px; y: 178px; width: parent.width - 56px; height: 420px;
            background: #edf1f2; border-radius: 14px;
            border-width: 1px; border-color: #b8c2c7;
            drop-shadow-color: #26343c26; drop-shadow-offset-y: 7px; drop-shadow-blur: 18px;
            Text {
                x: 16px; y: 14px; width: 90px; height: 18px;
                text: root.language == "en" ? "SEQUENCE" : root.language == "ja" ? "シーケンス" : "编排序列";
                color: #007a7e; font-size: 10px; font-weight: 700;
            }
            HorizontalLayout {
                x: parent.width - 68px; y: 10px; width: 52px; height: 26px;
                OutlineButton { label-size: 11px; text: root.language == "en" ? "Clear" : root.language == "ja" ? "消去" : "清空"; enabled: root.sequence-editable && root.sequence-steps.length > 0; clicked => { root.sequence-clear(); } }
            }
            if (root.sequence-history-error != "") : Text {
                x: 108px; y: 14px; width: parent.width - 186px; height: 18px;
                text: root.sequence-history-error == "load"
                    ? (root.language == "en" ? "History could not be read" : root.language == "ja" ? "履歴を読み込めません" : "历史记录读取失败")
                    : (root.language == "en" ? "History could not be saved" : root.language == "ja" ? "履歴を保存できません" : "历史记录保存失败");
                color: #8b6b16; font-size: 10px; overflow: elide;
            }
            if (root.sequence-history.length > 0) : HorizontalLayout {
                x: 16px; y: 42px; width: parent.width - 32px; height: 28px; spacing: 8px;
                for entry[index] in root.sequence-history : HorizontalLayout {
                    horizontal-stretch: 1; spacing: 3px;
                    OutlineButton {
                        horizontal-stretch: 1; label-size: 11px; text: entry;
                        accessible-name: (root.language == "en" ? "Load recent sequence: " : root.language == "ja" ? "履歴を読み込む：" : "载入历史序列：") + entry;
                        enabled: root.sequence-editable;
                        clicked => { root.sequence-history-action(index, false); }
                    }
                    OutlineButton {
                        width: 28px; label-size: 16px; text: "×";
                        accessible-name: (root.language == "en" ? "Delete recent sequence: " : root.language == "ja" ? "履歴を削除：" : "删除历史序列：") + entry;
                        enabled: root.sequence-editable;
                        clicked => { root.sequence-history-action(index, true); }
                    }
                }
            }
            ScrollView {
                x: 16px; y: 38px + root.history-offset; width: parent.width - 32px; height: 54px;
                viewport-width: self.width;
                VerticalLayout {
                    spacing: 5px; alignment: start;
                    Text {
                    text: root.recorded-summary != "" ? root.recorded-summary : (root.language == "en" ? "Add key steps below" : root.language == "ja" ? "下でキーステップを追加" : "在下方添加按键步骤");
                    wrap: word-wrap; color: #11171c; font-size: 13px; font-weight: 650;
                    }

                    Text {
                        text: root.language == "en" ? "For in-app shortcuts, switch to the target window during the 3-second countdown." : root.language == "ja" ? "アプリ内の操作は3秒の間に対象ウィンドウへ切り替えます。" : "应用内快捷键请在 3 秒倒计时内切到目标窗口。";
                        wrap: word-wrap; color: #59676d; font-size: 11px;
                    }
                }
            }
            Rectangle { x: 16px; y: 104px + root.history-offset; width: parent.width - 32px; height: 1px; background: #ccd5d9; }
            HorizontalLayout {
                x: 16px; y: 114px + root.history-offset; width: parent.width - 32px; height: 28px; spacing: 8px;
                OutlineButton {
                    text: root.language == "en" ? "Sequence" : root.language == "ja" ? "編集" : "编排";
                    label-size: 12px;
                    background: root.sequence-tab == 0 ? #f8fafb : transparent;
                    enabled: !root.sequence-key-capturing;
                    clicked => { root.sequence-tab = 0; }
                }
                OutlineButton {
                    text: (root.language == "en" ? "Sent" : root.language == "ja" ? "送信" : "发送记录") + " (" + root.recorded-events.length + ")";
                    label-size: 12px;
                    background: root.sequence-tab == 1 ? #f8fafb : transparent;
                    enabled: !root.sequence-key-capturing;
                    clicked => { root.sequence-tab = 1; }
                }
                OutlineButton {
                    text: (root.language == "en" ? "Responses" : root.language == "ja" ? "応答" : "软件响应") + " (" + root.recorded-responses.length + ")";
                    label-size: 12px;
                    background: root.sequence-tab == 2 ? #f8fafb : transparent;
                    enabled: !root.sequence-key-capturing;
                    clicked => { root.sequence-tab = 2; }
                }
            }
            if (root.sequence-tab == 0) : ScrollView {
                x: 16px; y: 154px + root.history-offset; width: parent.width - 32px; height: 160px - root.history-offset;
                viewport-width: self.width;
                VerticalLayout {
                    spacing: 2px; alignment: start;
                    for step[index] in root.sequence-steps : HorizontalLayout {
                        height: 32px; spacing: 6px;
                        Rectangle {
                            width: 24px; background: transparent;
                            Rectangle {
                                y: 6px; width: 20px; height: 20px; border-radius: 10px;
                                background: step.done ? #d8eceb : #e2e8eb;
                                if (!step.done) : Text {
                                    text: "" + (index + 1); color: #536168; font-size: 10px;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                                if (step.done) : Path {
                                    x: 4px; y: 4px; width: 12px; height: 12px;
                                    commands: "M 1 6 L 4.5 9.5 L 11 2";
                                    fill: transparent; stroke: #007a7e; stroke-width: 1.8px;
                                }
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: (step.action == 0 ? (root.language == "en" ? "Tap " : root.language == "ja" ? "押して離す " : "点按 ")
                                : step.action == 1 ? (root.language == "en" ? "Key down " : root.language == "ja" ? "押下 " : "按下 ")
                                : step.action == 2 ? (root.language == "en" ? "Key up " : root.language == "ja" ? "解放 " : "松开 ")
                                : (root.language == "en" ? "Wait " : root.language == "ja" ? "待機 " : "等待 ")) + (step.action == 3 ? "" + step.delay + " ms" : step.key);
                            color: #11171c; font-size: 12px; vertical-alignment: center; overflow: elide;
                        }
                        Rectangle {
                            width: 88px; height: 28px;
                            border-width: 1px; border-color: #b8c2c7; border-radius: 6px;
                            background: #f8fafb;
                            HorizontalLayout {
                                x: 2px; width: 84px; spacing: 0px;
                                MoveStepButton { up: true; accessible-name: root.language == "en" ? "Move up" : root.language == "ja" ? "上へ" : "上移"; enabled: root.sequence-editable && index > 0; clicked => { root.sequence-edit(index, -1); } }
                                MoveStepButton { up: false; accessible-name: root.language == "en" ? "Move down" : root.language == "ja" ? "下へ" : "下移"; enabled: root.sequence-editable && index + 1 < root.sequence-steps.length; clicked => { root.sequence-edit(index, 1); } }
                                DeleteStepButton { accessible-name: root.language == "en" ? "Delete step" : root.language == "ja" ? "ステップを削除" : "删除步骤"; enabled: root.sequence-editable; clicked => { root.sequence-edit(index, 0); } }
                            }
                            Rectangle { x: 29.5px; y: 6px; width: 1px; height: 16px; background: #d8e0e4; }
                            Rectangle { x: 57.5px; y: 6px; width: 1px; height: 16px; background: #d8e0e4; }
                        }
                    }
                }
            }
            if (root.sequence-tab == 0) : HorizontalLayout {
                x: 16px; y: 320px; width: parent.width - 32px; height: 24px; spacing: 8px;
                Text { width: 100px; text: root.language == "en" ? "Action" : root.language == "ja" ? "操作" : "动作"; color: #536168; font-size: 11px; vertical-alignment: center; }
                Text { width: 140px; text: root.sequence-action-kind == 3 ? (root.language == "en" ? "Wait (ms)" : root.language == "ja" ? "待機（ms）" : "等待（ms）") : (root.language == "en" ? "Key" : root.language == "ja" ? "キー" : "按键"); color: #536168; font-size: 11px; vertical-alignment: center; }
                if (root.sequence-action-kind != 3) : OutlineButton {
                    horizontal-stretch: 1; label-size: 11px;
                    text: root.sequence-key-capturing ? (root.language == "en" ? "Cancel" : root.language == "ja" ? "中止" : "取消选取") : (root.language == "en" ? "Pick key" : root.language == "ja" ? "キーを入力" : "按键选取");
                    enabled: !root.professional-busy;
                    clicked => { root.sequence-capture-requested(); }
                }
            }
            if (root.sequence-tab == 0) : HorizontalLayout {
                x: 16px; y: 350px; width: parent.width - 32px; height: 32px; spacing: 8px;
                ComboBox { width: 100px; enabled: root.sequence-editable; model: root.language == "en" ? ["Tap", "Key down", "Key up", "Wait"] : root.language == "ja" ? ["押して離す", "押下", "解放", "待機"] : ["点按", "按下", "松开", "等待"]; current-index <=> root.sequence-action-kind; }
                if (root.sequence-action-kind != 3) : ComboBox { width: 140px; enabled: root.sequence-editable; model: root.sequence-keys; current-index <=> root.sequence-key; }
                if (root.sequence-action-kind == 3) : SpinBox { width: 140px; minimum: 20; maximum: 2000; step-size: 20; enabled: root.sequence-editable; value <=> root.sequence-delay; }
                OutlineButton { horizontal-stretch: 1; label-size: 12px; text: root.language == "en" ? "Add" : root.language == "ja" ? "追加" : "添加"; enabled: root.sequence-editable && root.sequence-steps.length < 32; clicked => { root.sequence-add(); } }
            }
            if (root.sequence-tab == 0) : Text {
                x: 16px; y: 388px; width: parent.width - 32px; height: 22px;
                text: root.sequence-key-capturing
                    ? (root.sequence-key-capture-unknown
                        ? (root.language == "en" ? "Key not recognized. Try another or cancel to use the list." : root.language == "ja" ? "未対応のキーです。再入力か、中止して一覧から選択。" : "未识别此键，请重试或取消后从列表选择。")
                        : (root.language == "en" ? "Press one key. Esc is selectable; click Cancel to stop." : root.language == "ja" ? "キーを1つ入力。Escも選択できます。中止はクリック。" : "请按一个键；Esc 也可选，取消请用鼠标。"))
                    : root.sequence-validation != "" ? root.sequence-validation : (root.language == "en" ? "32 steps · 5 seconds maximum" : root.language == "ja" ? "最大32ステップ・5秒" : "最多 32 步 · 总时长 5 秒");
                color: root.sequence-key-capturing ? #007a7e : root.sequence-valid ? #59676d : #8b6b16; font-size: 11px; wrap: word-wrap;
            }
            if (root.sequence-tab == 1) : HorizontalLayout {
                x: 16px; y: 154px + root.history-offset; width: parent.width - 32px; height: 18px; spacing: 8px;
                Text { width: 74px; text: root.language == "en" ? "Time" : root.language == "ja" ? "時刻" : "相对时间"; color: #536168; font-size: 11px; }
                Text { horizontal-stretch: 1; text: root.language == "en" ? "Key" : root.language == "ja" ? "キー" : "按键"; color: #536168; font-size: 11px; }
                Text { width: 98px; text: root.language == "en" ? "Event" : root.language == "ja" ? "イベント" : "动作"; color: #536168; font-size: 11px; }
            }
            if (root.sequence-tab == 1) : ScrollView {
                x: 16px; y: 178px + root.history-offset; width: parent.width - 32px; height: 226px - root.history-offset;
                viewport-width: self.width;
                VerticalLayout {
                    spacing: 0px;
                    for event in root.recorded-events : HorizontalLayout {
                        height: 26px; spacing: 8px;
                        Text { width: 74px; text: event.time; color: #536168; font-size: 11px; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: event.key; color: #11171c; font-size: 12px; font-weight: 650; vertical-alignment: center; overflow: elide; }
                        Text {
                            width: 98px;
                            text: (event.action == "held"
                                ? (root.language == "en" ? "Already held" : root.language == "ja" ? "押下済み" : "开始时已按住")
                                : event.action == "repeat"
                                ? (root.language == "en" ? "Repeat" : root.language == "ja" ? "リピート" : "重复")
                                : event.action == "down"
                                ? (root.language == "en" ? "Down" : root.language == "ja" ? "押下" : "按下")
                                : event.action == "up-missing"
                                ? (root.language == "en" ? "Up (no down)" : root.language == "ja" ? "解放（押下なし）" : "松开（缺按下）")
                                : (root.language == "en" ? "Up" : root.language == "ja" ? "解放" : "松开"))
                                + "";
                            color: event.action == "up-missing" ? #8b6b16 : event.action == "up" ? #536168 : #007a7e;
                            font-size: 11px; vertical-alignment: center;
                        }
                    }
                }
            }
            if ((root.sequence-tab == 1) && root.recorded-events.length == 0) : Text {
                x: 16px; y: 180px + root.history-offset; width: parent.width - 32px; height: 44px;
                text: root.language == "en" ? "No events sent yet" : root.language == "ja" ? "まだ送信されていません" : "尚未发送按键事件";
                color: #59676d; font-size: 12px; horizontal-alignment: center; wrap: word-wrap;
            }
            if (root.sequence-tab == 2) : ScrollView {
                x: 16px; y: 154px + root.history-offset; width: parent.width - 32px; height: 250px - root.history-offset;
                viewport-width: self.width;
                VerticalLayout {
                    spacing: 12px;
                    for response in root.recorded-responses : VerticalLayout {
                        spacing: 3px;
                        Text { text: response.time + " · " + response.app; color: #11171c; font-size: 12px; font-weight: 650; wrap: word-wrap; }
                        Text {
                            text: response.kind == "carbon" ? (root.language == "en" ? "Marked Carbon hotkey receipt" : root.language == "ja" ? "本テストの Carbon 熱鍵通知" : "收到本次测试的 Carbon 系统热键通知") : response.kind == "hotkey"
                                ? (root.language == "en" ? "Hotkey receiver: " : root.language == "ja" ? "熱鍵の受信: " : "组合热键接收：") + response.value
                                : (root.language == "en" ? "Hotkey notice · Slot " : root.language == "ja" ? "熱鍵通知 · スロット " : "热键触发通知 · 槽位 ") + response.value;
                            color: #007a7e; font-size: 11px; wrap: word-wrap;
                        }
                        if (response.binding != "") : Text {
                            text: (root.language == "en" ? "Active binding: " : root.language == "ja" ? "実行中の設定: " : "活动绑定：") + response.binding;
                            color: #344249; font-size: 12px; wrap: word-wrap;
                        }
                        if (response.kind != "hotkey") : Text {
                            text: response.matched
                                ? (root.language == "en" ? "Active binding matches the test input."
                                    : root.language == "ja" ? "実行中の設定とテスト入力が一致します。" : "活动绑定与测试输入相符。")
                                : (root.language == "en" ? "Link to this key sequence is unconfirmed."
                                    : root.language == "ja" ? "この入力との対応は未確認です。" : "与本次按键序列的关联尚未确认。" );
                            color: response.matched ? #007a7e : #59676d; font-size: 11px; wrap: word-wrap;
                        }
                        if (response.matched) : Text {
                            text: (root.language == "en" ? "Input: " : root.language == "ja" ? "入力: " : "对应输入：") + response.input-range;
                            color: #59676d; font-size: 11px;
                        }
                        Text { text: "PID " + response.pid + (root.is-macos ? " · macOS" : " / TID " + response.tid + " · " + response.architecture); color: #59676d; font-size: 10px; }
                        Text { text: response.path; color: #59676d; font-size: 10px; wrap: word-wrap; }
                    }
                }
            }
            if ((root.sequence-tab == 2) && root.recorded-responses.length == 0) : Text {
                x: 16px; y: 180px + root.history-offset; width: parent.width - 32px; height: 84px;
                text: root.language == "en" ? "No supported response observed. This does not rule out other keyboard listeners."
                    : root.language == "ja" ? "対応する応答を観測していません。他のキー監視は除外できません。"
                    : "尚未观察到受支持的响应；不能据此排除其他键盘监听。";
                color: #59676d; font-size: 12px; horizontal-alignment: center; wrap: word-wrap;
            }
        }

        if (root.professional && !root.help-visible) : Text {
            x: 28px; y: 608px; width: parent.width - 56px; height: 28px;
            text: (root.recording-status != "" ? root.recording-status : root.mode == "sequence-result"
                ? (root.is-macos ? (root.language == "en" ? "Events submitted: " : root.language == "ja" ? "投入イベント：" : "已提交事件：") : (root.language == "en" ? "Events sent: " : root.language == "ja" ? "送信イベント：" : "已发送事件：")) + root.recorded-events.length
                : (root.language == "en" ? "3-second countdown · Actions will run" : root.language == "ja" ? "3秒の後に実行" : "倒计时 3 秒后发送 · 原操作会执行"))
                + (!root.is-macos && root.sequence-scope-ready ? (root.recording-admin ? (root.language == "en" ? " · Listening as administrator" : root.language == "ja" ? " · 管理者権限で監視" : " · 管理员权限监听") : (root.language == "en" ? " · Standard listening" : root.language == "ja" ? " · 通常権限で監視" : " · 普通权限监听")) : "");
            color: #59676d; font-size: 11px; wrap: word-wrap;
        }

        if (root.professional && !root.help-visible) : HorizontalLayout {
            x: 28px; y: 638px; width: parent.width - 56px; height: 40px; spacing: 12px;
            if (root.is-macos) : Text {
                text: root.language == "en" ? "Actions run as usual" : root.language == "ja" ? "元の操作も実行されます" : "原快捷键动作会正常执行";
                color: #59676d; font-size: 11px; vertical-alignment: center;
            }
            if (!root.professional-busy && !root.is-macos) : CheckBox {
                text: root.language == "en" ? "Listen as administrator" : root.language == "ja" ? "管理者権限で監視" : "以管理员权限监听";
                checked <=> root.include-admin;
            }
            ActionButton {
                width: 154px; height: 40px; text: root.action-text; action-color: #007a7e;
                enabled: root.action-enabled && !root.sequence-key-capturing;
                clicked => { root.sequence-action(); }
            }
        }

        filter-focus := FocusScope {
            width: parent.width; height: parent.height;
            enabled: root.filter-visible;
            if (root.filter-visible) : Rectangle {
                width: parent.width; height: parent.height;
                background: #edf1f2;
                TouchArea { }
                Text {
                    x: 24px; y: 22px; width: parent.width - 48px; height: 32px;
                    text: root.language == "en" ? "Choose apps to check" : root.language == "ja" ? "検査するアプリを選択" : "选择参与检查的软件";
                    font-size: 23px; font-weight: 700; color: #11171c;
                }
                Text {
                    x: 24px; y: 65px; width: parent.width - 48px; height: 76px;
                    text: root.language == "en" ? "Their global listeners will pause briefly. The shortcut runs several times; other shortcuts or remapping may pause too. Select up to 6 apps." : root.language == "ja" ? "選択したアプリのグローバル監視を一時停止し、組み合わせを複数回送信します。他のショートカットやキー変更も一時停止します。最大6個を選択。" : "将暂时停用所选软件的全局监听，并多次触发此组合。其间其他快捷键或按键重映射也可能暂停。最多选择 6 个软件。";
                    wrap: word-wrap; font-size: 13px; color: #45545b;
                }
                ScrollView {
                    x: 24px; y: 148px; width: parent.width - 48px; height: 232px;
                    viewport-width: self.width;
                    VerticalLayout {
                        alignment: start;
                        spacing: 8px;
                        for item[index] in root.filter-choices : VerticalLayout {
                            alignment: start;
                            vertical-stretch: 0;
                            spacing: 2px;
                            CheckBox {
                                text: item.name + " · PID " + item.pid;
                                checked: item.selected;
                                enabled: item.selected || root.filter-selected < 6;
                                toggled => { root.toggle-filter(index, self.checked); }
                            }
                            Text { text: item.path; font-size: 10px; color: #59676d; overflow: elide; }
                        }
                    }
                }
                Text {
                    x: 24px; y: 390px; width: parent.width - 48px; height: 50px;
                    text: root.filter-message;
                    wrap: word-wrap; font-size: 12px; color: #59676d;
                }
                HorizontalLayout {
                    x: 24px; y: 456px; width: parent.width - 48px; height: 40px; spacing: 10px;
                    OutlineButton { text: root.language == "en" ? "Back" : root.language == "ja" ? "戻る" : "返回"; clicked => { root.filter-visible = false; } }
                    OutlineButton { text: root.language == "en" ? "Refresh" : root.language == "ja" ? "更新" : "刷新列表"; clicked => { root.show-filters(); } }
                    ActionButton {
                        text: root.language == "en" ? "Start check" : root.language == "ja" ? "検査を開始" : "开始检查";
                        enabled: root.filter-selected > 0 && root.filter-selected <= 6;
                        action-color: #8b6b16;
                        clicked => { root.start-filters(); }
                    }
                }
            }
        }

    }
}
