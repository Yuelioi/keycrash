/*
THESIS: 虚拟修饰键与一个本地目标键汇成可解释的检测轨迹，拒绝真实触发完整快捷键。
OWN-WORLD: 冷灰仪器面板、墨黑读数、青色确认、红橙操作，以及检测时出现的正交信号轨迹。
STORY: 用户点选 modifier tags，点击开始，只按一个目标键，然后读取结论与证据边界。
FIRST VIEWPORT: 460×380 单窗口，上方是品牌和状态，中部是 modifier tags、目标键读数与测量轨迹，底部只有一个主操作。
FORM: 信号轨迹视觉世界；证据剖面式层级，种子 132c565a。
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
*/

component LanguageSelect inherits Rectangle {
    in property <string> language;
    in property <bool> enabled: true;
    in property <string> accessible-name;
    callback selected(string);
    property <[string]> labels: ["简体中文", "English", "日本語"];
    property <[string]> codes: ["zh", "en", "ja"];
    property <int> current: language == "en" ? 1 : language == "ja" ? 2 : 0;
    property <int> highlighted;
    property <bool> keyboard-focus: false;
    property <bool> expanded: false;

    width: 112px;
    height: 30px;
    border-radius: 8px;
    background: touch.has-hover && enabled ? #edf1f2 : #f8fafb;
    border-width: 1px;
    border-color: focus.has-focus && keyboard-focus && enabled ? #536168 : #aab6bc;
    opacity: enabled ? 1 : 0.42;
    forward-focus: focus;
    accessible-role: combobox;
    accessible-label: accessible-name;
    accessible-value: labels[current];
    accessible-enabled: enabled;
    accessible-expandable: true;
    accessible-expanded: expanded;
    accessible-action-expand => { root.open(); }

    function open() {
        if root.enabled {
            root.highlighted = root.current;
            root.expanded = true;
            menu.show();
        }
    }

    Text {
        x: 10px; width: parent.width - 34px; height: parent.height;
        text: root.labels[root.current]; color: #344249; font-size: 12px;
        vertical-alignment: center;
        accessible-role: none;
    }
    Path {
        x: parent.width - 18px; y: 13px; width: 8px; height: 4px;
        commands: "M 0 0 L 4 4 L 8 0";
        stroke: #536168; stroke-width: 1.4px;
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        focus-lost => { root.keyboard-focus = false; }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return || event.text == Key.DownArrow || event.text == Key.UpArrow {
                root.keyboard-focus = true;
                root.open();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.keyboard-focus = false; root.open(); }
    }
    menu := PopupWindow {
        x: 0px; y: root.height + 5px;
        width: root.width; height: 104px;
        close-policy: close-on-click-outside;
        forward-focus: menu-focus;
        Rectangle {
            background: #f8fafb;
            border-radius: 8px;
            border-width: 1px; border-color: #b8c2c7;
        }
        menu-focus := FocusScope {
            focus-changed-event => { root.expanded = self.has-focus; }
            key-pressed(event) => {
                if event.text == Key.DownArrow { root.highlighted = mod(root.highlighted + 1, 3); return accept; }
                if event.text == Key.UpArrow { root.highlighted = mod(root.highlighted + 2, 3); return accept; }
                if event.text == Key.Return || event.text == Key.Space {
                    root.selected(root.codes[root.highlighted]); menu.close(); focus.focus(); root.keyboard-focus = true; return accept;
                }
                if event.text == Key.Escape || event.text == Key.Tab { menu.close(); focus.focus(); root.keyboard-focus = true; return accept; }
                return reject;
            }
            for label[index] in root.labels : Rectangle {
                x: 4px; y: 4px + index * 32px; width: parent.width - 8px; height: 32px;
                border-radius: 5px;
                background: row-touch.has-hover || root.highlighted == index ? #e3e9ec : transparent;
                accessible-role: button;
                accessible-label: label;
                accessible-action-default => { root.selected(root.codes[index]); menu.close(); }
                Text {
                    x: 8px; height: parent.height; text: label;
                    font-size: 12px; font-weight: root.current == index ? 650 : 400;
                    color: #344249; vertical-alignment: center;
                }
                row-touch := TouchArea {
                    clicked => { root.keyboard-focus = false; root.selected(root.codes[index]); menu.close(); }
                }
            }
        }
    }
}

component SignalTrace inherits Rectangle {
    in property <color> signal-color;
    in property <bool> active;

    background: transparent;
    opacity: active ? 1 : 0;
    animate opacity { duration: 160ms; easing: ease-out; }

    Rectangle { x: 0px; y: 9px; width: 39px; height: 2px; background: root.signal-color; }
    Rectangle { x: 38px; y: 3px; width: 2px; height: 8px; background: root.signal-color; }
    Rectangle { x: 39px; y: 3px; width: 29px; height: 2px; background: root.signal-color; }
    Rectangle { x: 67px; y: 3px; width: 2px; height: 8px; background: root.signal-color; }
    Rectangle { x: 68px; y: 9px; width: 128px; height: 2px; background: root.signal-color; }

    Rectangle { x: 0px; y: 23px; width: 69px; height: 2px; background: root.signal-color; }
    Rectangle { x: 68px; y: 16px; width: 2px; height: 9px; background: root.signal-color; }
    Rectangle { x: 69px; y: 16px; width: 31px; height: 2px; background: root.signal-color; }
    Rectangle { x: 99px; y: 16px; width: 2px; height: 9px; background: root.signal-color; }
    Rectangle { x: 100px; y: 23px; width: 96px; height: 2px; background: root.signal-color; }

    Rectangle { x: 0px; y: 37px; width: 105px; height: 2px; background: root.signal-color; }
    Rectangle { x: 104px; y: 30px; width: 2px; height: 9px; background: root.signal-color; }
    Rectangle { x: 105px; y: 30px; width: 31px; height: 2px; background: root.signal-color; }
    Rectangle { x: 135px; y: 30px; width: 2px; height: 9px; background: root.signal-color; }
    Rectangle { x: 136px; y: 37px; width: 60px; height: 2px; background: root.signal-color; }

    Rectangle { x: 195px; y: 9px; width: 2px; height: 30px; background: root.signal-color; }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> action-color;
    callback clicked;

    height: 44px;
    border-radius: 10px;
    background: root.action-color;
    opacity: !root.enabled ? 0.42 : touch.pressed ? 0.78 : touch.has-hover ? 0.9 : 1;
    forward-focus: focus-scope;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-action-default => { touch.clicked(); }

    animate opacity { duration: 110ms; easing: ease-out; }

    Text {
        text: root.text;
        color: #ffffff;
        font-size: 13px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    focus-scope := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    if (focus-scope.has-focus && root.enabled) : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 13px;
        border-width: 2px;
        border-color: #11171c;
    }
}

component ModifierTag inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <string> add-label: "添加 ";
    in property <string> remove-label: "移除 ";
    callback toggled;

    width: 58px;
    height: 30px;
    border-radius: 9px;
    background: root.selected ? #11171c : #f8fafb;
    border-width: 1px;
    border-color: root.selected ? #11171c : #aab6bc;
    opacity: root.enabled ? (touch.pressed ? 0.76 : touch.has-hover ? 0.9 : 1) : 0.58;
    forward-focus: focus-scope;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-label: root.selected ? root.remove-label + root.text : root.add-label + root.text;
    accessible-action-default => { touch.clicked(); }

    animate background, opacity { duration: 110ms; easing: ease-out; }

    Text {
        text: root.selected ? root.text + "  ×" : "+  " + root.text;
        color: root.selected ? #ffffff : #344249;
        font-size: 12px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    focus-scope := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            focus-scope.focus();
            root.toggled();
        }
    }

    if (focus-scope.has-focus && root.enabled) : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 11px;
        border-width: 2px;
        border-color: #c9342a;
    }
}

component OutlineButton inherits Rectangle {
    in property <string> text;
    in property <string> accessible-name: root.text;
    in property <bool> enabled: true;
    in property <length> corner-radius: 8px;
    in property <length> label-size: 13px;
    callback clicked;

    background: touch.pressed ? #d7dddf : touch.has-hover ? #f8fafb : transparent;
    border-width: 1px;
    border-color: #aab6bc;
    border-radius: root.corner-radius;
    opacity: root.enabled ? 1 : 0.42;
    forward-focus: focus-scope;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.accessible-name;
    accessible-action-default => { touch.clicked(); }

    animate background, opacity { duration: 110ms; easing: ease-out; }

    property <bool> focus-ring-visible: false;

    Text {
        text: root.text;
        color: #344249;
        font-size: root.label-size;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    focus-scope := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => {
            root.focus-ring-visible = reason == FocusReason.tab-navigation
                || reason == FocusReason.programmatic;
        }
        focus-lost => {
            root.focus-ring-visible = false;
        }
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && focus-scope.has-focus) {
                focus-scope.clear-focus();
            }
        }
        clicked => {
            root.clicked();
        }
    }

    if (focus-scope.has-focus && root.focus-ring-visible && root.enabled) : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: root.corner-radius + 2px;
        border-width: 2px;
        border-color: #11171c;
    }
}

export component AppWindow inherits Window {
    width: 460px;
    height: 380px;
    in property <string> app-version;
    title: "KeyCrash v" + root.app-version;
    icon: @image-url("../assets/keycrash-icon.svg");
    background: #dce2e5;

    in-out property <string> mode: "idle";
    in-out property <string> state-title: "选择修饰键";
    in-out property <string> state-detail: "单击 Ctrl、Alt、Shift；开始后只按一个目标键。";
    in-out property <string> shortcut-text: "等待目标键";
    in-out property <string> evidence-text: "安全输入 · 不发送完整组合";
    in-out property <string> action-text: "开始检测";
    in-out property <color> accent: #c9342a;
    in-out property <bool> ctrl-selected: false;
    in-out property <bool> alt-selected: false;
    in-out property <bool> shift-selected: false;
    in-out property <bool> action-enabled: true;
    in-out property <string> owner-path: "";
    in-out property <string> language: "zh";
    property <bool> help-visible: false;

    callback begin-detection(bool, bool, bool);
    callback action-key-entered(string, bool, bool, bool);
    callback cancel-requested();
    callback modifiers-changed();
    callback locate-owner();
    callback open-owner-location();
    callback language-changed(string);

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: transparent;

        capture-focus := FocusScope {
            x: -1px;
            y: -1px;
            width: 1px;
            height: 1px;
            enabled: root.mode == "waiting-key" && !root.help-visible;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.cancel-requested();
                    return accept;
                }
                if (event.modifiers.control || event.modifiers.alt || event.modifiers.shift || event.modifiers.meta) {
                    return accept;
                }
                root.action-key-entered(event.text, root.ctrl-selected, root.alt-selected, root.shift-selected);
                return accept;
            }
        }

        Rectangle {
            x: 28px;
            y: 24px;
            width: parent.width - 56px;
            height: 99px;
            background: transparent;

            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 34px;
                alignment: start;
                spacing: 10px;

                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 8px;
                    background: #11171c;

                    Text {
                        text: "K";
                        color: #f3f6f7;
                        font-size: 17px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        x: 6px;
                        y: 27px;
                        width: 22px;
                        height: 2px;
                        background: root.accent;
                    }
                }

                VerticalLayout {
                    spacing: 1px;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 7px;
                        Text {
                            text: "KeyCrash";
                            color: #11171c;
                            font-size: 16px;
                            font-weight: 700;
                        }
                        Text {
                            text: "v" + root.app-version;
                            color: #536168;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: root.language == "en" ? "One key to find the conflict" : root.language == "ja" ? "1 キーで競合を検出" : "一按，找到快捷键冲突";
                        color: #536168;
                        font-size: 11px;
                    }
                }
            }

            Text {
                x: 0px;
                y: 50px;
                width: parent.width;
                height: 30px;
                text: root.state-title;
                color: #11171c;
                font-size: 25px;
                font-weight: 700;
                overflow: elide;
                visible: !root.help-visible;
            }

            Text {
                x: 0px;
                y: 83px;
                width: parent.width;
                height: 16px;
                text: root.state-detail;
                color: #45545b;
                font-size: 13px;
                overflow: elide;
                visible: !root.help-visible;
            }
        }

        Rectangle {
            x: 28px;
            y: 138px;
            width: parent.width - 56px;
            height: 142px;
            background: #edf1f2;
            border-width: 1px;
            border-color: #b8c2c7;
            border-radius: 14px;
            drop-shadow-color: #26343c26;
            drop-shadow-offset-y: 7px;
            drop-shadow-blur: 18px;
            visible: !root.help-visible;

            Rectangle { x: 18px; y: 29px; width: parent.width - 36px; height: 1px; background: root.mode == "waiting-key" ? #cdd5d8 : #e4e9ea; }
            Rectangle { x: 18px; y: 57px; width: parent.width - 36px; height: 1px; background: root.mode == "waiting-key" ? #cdd5d8 : #e4e9ea; }
            Rectangle { x: 18px; y: 85px; width: parent.width - 36px; height: 1px; background: root.mode == "waiting-key" ? #cdd5d8 : #e4e9ea; }
            Rectangle { x: 18px; y: 113px; width: parent.width - 36px; height: 1px; background: root.mode == "waiting-key" ? #cdd5d8 : #e4e9ea; }
            Rectangle { x: 79px; y: 16px; width: 1px; height: parent.height - 32px; background: root.mode == "waiting-key" ? #d7dddf : #e8eced; }
            Rectangle { x: 151px; y: 16px; width: 1px; height: parent.height - 32px; background: root.mode == "waiting-key" ? #d7dddf : #e8eced; }
            Rectangle { x: 223px; y: 16px; width: 1px; height: parent.height - 32px; background: root.mode == "waiting-key" ? #d7dddf : #e8eced; }
            Rectangle { x: 295px; y: 16px; width: 1px; height: parent.height - 32px; background: root.mode == "waiting-key" ? #d7dddf : #e8eced; }
            Rectangle { x: 367px; y: 16px; width: 1px; height: parent.height - 32px; background: root.mode == "waiting-key" ? #d7dddf : #e8eced; }

            HorizontalLayout {
                x: 18px;
                y: 17px;
                width: 190px;
                height: 30px;
                spacing: 7px;
                alignment: start;

                ModifierTag {
                    text: "Ctrl";
                    add-label: root.language == "en" ? "Add " : root.language == "ja" ? "追加 " : "添加 ";
                    remove-label: root.language == "en" ? "Remove " : root.language == "ja" ? "削除 " : "移除 ";
                    selected: root.ctrl-selected;
                    enabled: root.mode != "waiting-key" && root.mode != "locating";
                    toggled => {
                        root.ctrl-selected = !root.ctrl-selected;
                        root.modifiers-changed();
                    }
                }
                ModifierTag {
                    text: "Alt";
                    add-label: root.language == "en" ? "Add " : root.language == "ja" ? "追加 " : "添加 ";
                    remove-label: root.language == "en" ? "Remove " : root.language == "ja" ? "削除 " : "移除 ";
                    selected: root.alt-selected;
                    enabled: root.mode != "waiting-key" && root.mode != "locating";
                    toggled => {
                        root.alt-selected = !root.alt-selected;
                        root.modifiers-changed();
                    }
                }
                ModifierTag {
                    text: "Shift";
                    add-label: root.language == "en" ? "Add " : root.language == "ja" ? "追加 " : "添加 ";
                    remove-label: root.language == "en" ? "Remove " : root.language == "ja" ? "削除 " : "移除 ";
                    selected: root.shift-selected;
                    enabled: root.mode != "waiting-key" && root.mode != "locating";
                    toggled => {
                        root.shift-selected = !root.shift-selected;
                        root.modifiers-changed();
                    }
                }
            }

            Text {
                x: 18px;
                y: 58px;
                width: 190px;
                height: 38px;
                visible: root.mode != "waiting-key" && root.mode != "locating";
                text: root.language == "en"
                    ? (root.ctrl-selected || root.alt-selected || root.shift-selected ? "Click a selected tag to remove it" : "Add the modifiers you need")
                    : root.language == "ja"
                        ? (root.ctrl-selected || root.alt-selected || root.shift-selected ? "選択済みのタグをクリックして削除" : "必要な修飾キーを追加")
                        : (root.ctrl-selected || root.alt-selected || root.shift-selected ? "已选 tag 可再次单击移除" : "单击添加需要的修饰键");
                color: #5e6c72;
                font-size: 11px;
                wrap: word-wrap;
            }

            SignalTrace {
                x: 24px;
                y: 55px;
                width: 196px;
                height: 46px;
                signal-color: root.accent;
                active: root.mode == "waiting-key" || root.mode == "locating";
            }

            Rectangle {
                x: 218px;
                y: 32px;
                width: parent.width - 242px;
                height: 62px;
                background: #f8fafb;
                border-width: 1px;
                border-color: root.accent;
                border-radius: 10px;

                Text {
                    text: root.shortcut-text;
                    color: #11171c;
                    font-size: 15px;
                    font-weight: 650;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                x: 18px;
                y: 118px;
                width: parent.width - 36px;
                height: 16px;
                alignment: space-between;

                Text {
                    text: root.mode == "available" ? "READY" : root.mode == "owner-found" ? "OWNER" : root.mode == "occupied" ? "BLOCKED" : root.mode == "reserved" ? "RESERVED" : root.mode == "locating" ? "LOCATING" : root.mode == "waiting-key" ? "LOCAL INPUT" : root.mode == "error" ? "ERROR" : "STANDBY";
                    color: root.accent;
                    font-size: 10px;
                    font-weight: 700;
                }
                Text {
                    text: root.evidence-text;
                    color: #5e6c72;
                    font-size: 10px;
                    horizontal-alignment: right;
                    overflow: elide;
                }
            }
        }

        HorizontalLayout {
            x: 28px;
            y: 314px;
            width: parent.width - 56px;
            height: 44px;
            alignment: space-between;
            spacing: 14px;
            visible: !root.help-visible;

            if (root.mode == "owner-found") : OutlineButton {
                width: 132px;
                height: 44px;
                corner-radius: 10px;
                label-size: 12px;
                text: root.language == "en" ? "Open file location" : root.language == "ja" ? "ファイルの場所を開く" : "打开文件位置";
                enabled: root.owner-path != "";
                clicked => { root.open-owner-location(); }
            }

            if (root.mode != "owner-found") : HorizontalLayout {
                spacing: 7px;
                VerticalLayout {
                    width: 8px;
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 2px;
                        background: root.accent;
                    }
                }
                Text {
                    text: root.mode == "waiting-key"
                        ? (root.language == "en" ? "Esc cancels · Target key only" : root.language == "ja" ? "Esc でキャンセル · 対象キーのみ" : "Esc 取消 · 只按目标键")
                        : root.mode == "locating"
                            ? (root.language == "en" ? "One trigger · Observe process messages" : root.language == "ja" ? "1 回送信 · プロセスメッセージを観測" : "触发一次 · 观察进程消息")
                            : "Windows 10 / 11";
                    color: #59676d;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }

            ActionButton {
                width: 154px;
                text: root.action-text;
                enabled: root.action-enabled;
                action-color: root.accent;
                clicked => {
                    if (root.mode == "waiting-key") {
                        root.cancel-requested();
                    } else if (root.mode == "occupied") {
                        root.locate-owner();
                    } else {
                        root.begin-detection(root.ctrl-selected, root.alt-selected, root.shift-selected);
                        capture-focus.focus();
                    }
                }
            }
        }

        help-focus := FocusScope {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            enabled: root.help-visible;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.help-visible = false;
                    return accept;
                }
                return reject;
            }

            if (root.help-visible) : Rectangle {
                x: 28px;
                y: 72px;
                width: parent.width - 56px;
                height: 286px;
                background: #edf1f2;
                border-width: 1px;
                border-color: #b8c2c7;
                border-radius: 14px;
                drop-shadow-color: #26343c26;
                drop-shadow-offset-y: 7px;
                drop-shadow-blur: 18px;

                Text {
                    x: 20px;
                    y: 17px;
                    width: parent.width - 40px;
                    height: 28px;
                    text: root.language == "en" ? "How to use" : root.language == "ja" ? "使い方" : "怎么使用";
                    color: #11171c;
                    font-size: 25px;
                    font-weight: 700;
                }

                Text {
                    x: 20px;
                    y: 57px;
                    width: parent.width - 40px;
                    height: 22px;
                    text: root.language == "en" ? "1  Choose modifiers" : root.language == "ja" ? "1  修飾キーを選択" : "1  选择修饰键";
                    color: #11171c;
                    font-size: 13px;
                    font-weight: 650;
                }
                Text {
                    x: 38px;
                    y: 78px;
                    width: parent.width - 58px;
                    height: 32px;
                    text: root.language == "en" ? "Select Ctrl, Alt, or Shift. Start directly if none is needed." : root.language == "ja" ? "Ctrl、Alt、Shift を選択。不要な場合はそのまま開始します。" : "点选 Ctrl、Alt、Shift；不需要修饰键时可直接开始。";
                    color: #45545b;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Text {
                    x: 20px;
                    y: 116px;
                    width: parent.width - 40px;
                    height: 22px;
                    text: root.language == "en" ? "2  Enter the target key" : root.language == "ja" ? "2  対象キーを入力" : "2  输入目标键";
                    color: #11171c;
                    font-size: 13px;
                    font-weight: 650;
                }
                Text {
                    x: 38px;
                    y: 137px;
                    width: parent.width - 58px;
                    height: 32px;
                    text: root.language == "en" ? "Choose Start check, then press one key such as A, F1, or PrtSc." : root.language == "ja" ? "「検出を開始」を選び、A、F1、PrtSc などを 1 つ押します。" : "点“开始检测”，再按 A、F1、PrtSc 等一个目标键。";
                    color: #45545b;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Text {
                    x: 20px;
                    y: 175px;
                    width: parent.width - 40px;
                    height: 22px;
                    text: root.language == "en" ? "3  Locate the app" : root.language == "ja" ? "3  使用中のアプリを特定" : "3  定位占用软件";
                    color: #11171c;
                    font-size: 13px;
                    font-weight: 650;
                }
                Text {
                    x: 38px;
                    y: 196px;
                    width: parent.width - 58px;
                    height: 44px;
                    text: root.language == "en" ? "When shown as in use, choose Locate. This sends the shortcut, so its action may run." : root.language == "ja" ? "使用中と表示されたら「特定」を選びます。ショートカットの操作が実行される場合があります。" : "显示“已被占用”后点“定位占用软件”。定位会触发快捷键，原动作可能执行。";
                    color: #45545b;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Text {
                    x: 20px;
                    y: 252px;
                    width: parent.width - 40px;
                    height: 18px;
                    text: root.language == "en" ? "Esc or × returns" : root.language == "ja" ? "Esc または × で戻る" : "Esc 或右上角 × 返回";
                    color: #59676d;
                    font-size: 11px;
                }
            }
        }

        OutlineButton {
            x: 402px;
            y: 26px;
            width: 30px;
            height: 30px;
            text: root.help-visible ? "×" : "?";
            accessible-name: root.language == "en" ? (root.help-visible ? "Close instructions" : "Open instructions") : root.language == "ja" ? (root.help-visible ? "使い方を閉じる" : "使い方を開く") : (root.help-visible ? "关闭使用说明" : "打开使用说明");
            enabled: root.mode != "locating";
            clicked => {
                if (root.help-visible) {
                    root.help-visible = false;
                } else {
                    if (root.mode == "waiting-key") {
                        root.cancel-requested();
                    }
                    root.help-visible = true;
                    help-focus.focus();
                }
            }
        }

        LanguageSelect {
            x: 282px;
            y: 26px;
            width: 112px;
            height: 30px;
            language: root.language;
            enabled: root.mode != "locating";
            accessible-name: root.language == "en" ? "Language" : root.language == "ja" ? "言語" : "语言";
            selected(value) => {
                root.language-changed(value);
            }
        }

    }
}
